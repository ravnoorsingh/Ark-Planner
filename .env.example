# Groq — https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Web search runs over MCP. ARK_SEARCH_BACKEND picks the provider (default: firecrawl);
# only that provider's key is required.
# Firecrawl — https://firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=fc-...

# Tavily — https://app.tavily.com  (only when ARK_SEARCH_BACKEND=tavily)
# TAVILY_API_KEY=tvly-...

# Bright Data Scraper Studio (needed only for `ark scrape` / `ark docs --scrape`)
#   token:     https://brightdata.com/cp/setting
#   collector: https://brightdata.com/cp/scrapers  (starts with c_)
BRIGHT_DATA_API_TOKEN=
BRIGHT_DATA_COLLECTOR_ID=

# Set only if your collector's content field isn't auto-detected.
# Run `uv run python scripts/check_brightdata.py <url>` to see the real row shape.
# BRIGHT_DATA_CONTENT_FIELD=markdown

# LangSmith tracing (optional) — https://smith.langchain.com/settings
# Off unless LANGSMITH_TRACING is true; prompts and doc excerpts are uploaded when on.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=ark-scrapper
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Characters of any single traced value sent to LangSmith (default 2000).
# ARK_TRACE_MAX_CHARS=2000

# Optional overrides
# ARK_MODEL=openai/gpt-oss-20b
# ARK_DATA_DIR=data
# ARK_MAX_ALTERNATES=2
# BRIGHT_DATA_POLL_INTERVAL=5
# BRIGHT_DATA_TIMEOUT=600
# ARK_TEMPERATURE=0.1
# ARK_MAX_LIBRARIES=8
# ARK_SEARCH_MAX_RESULTS=5
# ARK_OUTPUT_DIR=output
# ARK_SEARCH_BACKEND=firecrawl
# ARK_FIRECRAWL_MCP_URL=https://mcp.firecrawl.dev/v2/mcp
# ARK_TAVILY_MCP_URL=https://mcp.tavily.com/mcp/

# MongoDB (optional) — see docs/mongodb.md. Unset = filesystem only.
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=ark
# ARK_DOC_CACHE_TTL_DAYS=14
