  "main_content": "<head>\n<meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n    <meta name=\"color-scheme\" content=\"light dark\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<link rel=\"index\" title=\"Index\" href=\"genindex.html\">\n<link rel=\"search\" title=\"Search\" href=\"search.html\">\n<link rel=\"next\" title=\"First Steps\" href=\"first_steps.html\">\n\n    <link rel=\"shortcut icon\" href=\"https://www.courtbouillon.org/static/images/favicon.png\">\n<!-- Generated with Sphinx 7.3.7 and Furo 2024.08.06 -->\n        <title>WeasyPrint 69.0 documentation</title>\n      <link rel=\"stylesheet\" type=\"text/css\" href=\"_static/pygments.css?v=b20cc3f5\">\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"_static/styles/furo.css?v=354aac6f\">\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"_static/styles/furo-extensions.css?v=302659d7\">\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"https://www.courtbouillon.org/static/docs-furo.css\">\n    \n    \n\n\n<style>\n  body {\n    --color-code-background: #272822;\n  --color-code-foreground: #f8f8f2;\n  \n  }\n  @media not print {\n    body[data-theme=\"dark\"] {\n      --color-code-background: #202020;\n  --color-code-foreground: #d0d0d0;\n  \n    }\n    @media (prefers-color-scheme: dark) {\n      body:not([data-theme=\"light\"]) {\n        --color-code-background: #202020;\n  --color-code-foreground: #d0d0d0;\n  \n      }\n    }\n  }\n</style>\n<link rel=\"stylesheet\" href=\"https://www.courtbouillon.org/static/versions.css\" type=\"text/css\">\n</head>\n  <body data-theme=\"auto\">\n    \n    <script>\n      document.body.dataset.theme = localStorage.getItem(\"theme\") || \"auto\";\n    </script>\n    \n\n<svg xmlns=\"http://www.w3.org/2000/svg\" style=\"display: none;\">\n  <symbol id=\"svg-toc\" viewBox=\"0 0 24 24\">\n    <title>Contents</title>\n    <svg stroke=\"currentColor\" fill=\"currentColor\" str