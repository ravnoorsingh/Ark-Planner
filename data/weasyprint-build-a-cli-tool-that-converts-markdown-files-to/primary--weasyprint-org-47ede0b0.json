{
  "url": "https://weasyprint.org/",
  "main_content": "<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width initial-scale=1\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n    <link href=\"css/img/logotype-picto.svg\" type=\"image/svg\" rel=\"shortcut icon\">\n    <link href=\"css/screen.css\" rel=\"stylesheet\" media=\"screen\">\n    <link href=\"css/print.css\" rel=\"stylesheet\" media=\"print\">\n    <link href=\"https://www.courtbouillon.org/blog.rss\" type=\"application/rss+xml\" rel=\"alternate\" title=\"RSS feed\">\n\n    <title>WeasyPrint</title>\n    <meta name=\"description\" content=\"WeasyPrint, The Awesome Document Factory. Transform HTML and CSS into PDF documents.\">\n  </head>\n\n  <body>\n    <nav>\n      <ul>\n        <li>\n<a href=\"#samples\">Samples</a>\n</li>\n        <li>\n<a href=\"https://doc.courtbouillon.org/weasyprint/\">Documentation</a>\n</li>\n        <li>\n<a href=\"#support\">Professional Support</a>\n</li>\n        <li>\n<a href=\"https://www.courtbouillon.org/blog-articles\">Blog</a>\n</li>\n        <li id=\"sponsor\">\n<a href=\"https://opencollective.com/courtbouillon\">Become a Sponsor</a>\n</li>\n      </ul>\n    </nav>\n\n    <aside>\nWeasyPrint − The Awesome Document Factory\n</aside>\n\n    <main>\n      <h1>WeasyPrint</h1>\n\n      <section id=\"factory\">\n        <h2>The Awesome Document Factory</h2>\n\n        <p>\n\n          WeasyPrint is a smart solution helping web developers to create PDF\n          documents. It’s free and open source software that can be easily\n          plugged to your applications and websites and turns simple\n          \n<strong>HTML pages</strong>\n into gorgeous:\n        \n</p>\n\n        <form id=\"data-sample\">\n          <label>\n<input type=\"radio\" name=\"data-sample\" value=\"reports\" checked=\"\">\n\nStatistical reports\n</label>\n          <label>\n<input type=\"radio\" name=\"data-sample\" value=\"invoices\">\n\nInvoices\n</label>\n          <label>\n<input type=\"radio\" name=\"data-sample\" value=\"tickets\">\n\nTickets\n</label>\n        </form>\n\n        <form id=\"print\">\n          <label>\n<input type=\"checkbox\">\nhtml print\n</label>\n        </form>\n\n        <dl>\n          <dt>Statistical report</dt>\n          <dd data-sample=\"reports\" class=\"thumbnail\">\n<img src=\"css/img/documents/reports-thumbnail.webp\" alt=\"Statistical reports\">\n</dd>\n          <dd data-sample=\"reports\" class=\"html\">\n<img src=\"css/img/documents/reports-html.webp\" alt=\"Statistical reports\">\n</dd>\n          <dt>Invoices report</dt>\n          <dd data-sample=\"invoices\" class=\"thumbnail\">\n<img src=\"css/img/documents/invoices-thumbnail.webp\" alt=\"Invoices\">\n</dd>\n          <dd data-sample=\"invoices\" class=\"html\">\n<img src=\"css/img/documents/invoices-html.webp\" alt=\"Invoices\">\n</dd>\n          <dt>Tickets</dt>\n          <dd data-sample=\"tickets\" class=\"thumbnail\">\n<img src=\"css/img/documents/tickets-thumbnail.webp\" alt=\"Tickets\">\n</dd>\n          <dd data-sample=\"tickets\" class=\"html\">\n<img src=\"css/img/documents/tickets-html.webp\" alt=\"Tickets\">\n</dd>\n        </dl>\n      </section>\n\n      <section id=\"figures\">\n        <h2>Key Figures</h2>\n        <ul>\n          <li>\n<span>15</span>\n years of experience\n</li>\n          <li>\n<span>25M</span>\n downloads last month\n</li>\n          <li>\n<span>9.3k</span>\n stargazers on GitHub\n</li>\n        </ul>\n      </section>\n\n      <section id=\"samples\">\n        <h2>Samples</h2>\n\n        <article>\n          <h3>Reports</h3>\n\n          <img loading=\"lazy\" src=\"css/img/documents/reports-thumbnail.webp\" alt=\"Report thumbnail\">\n\n          <p>\n\n            A small report with a \n<strong>table of contents</strong>\n,\n            \n<strong>customized headers</strong>\n,\n            \n<strong>different page layouts</strong>\n and\n            \n<strong>nice typography features</strong>\n.\n          \n</p>\n\n          <ul class=\"buttons\">\n            <li>\n<a href=\"https://github.com/CourtBouillon/weasyprint-samples/raw/main/report/report.pdf\">\nPDF\n</a>\n</li>\n            <li>\n<a href=\"https://github.com/CourtBouillon/weasyprint-samples/tree/main/report\">\nSource\n</a>\n</li>\n          </ul>\n        </article>\n\n        <article>\n          <h3>Invoices</h3>\n\n          <img loading=\"lazy\" src=\"css/img/documents/invoices-thumbnail.webp\" alt=\"Invoice thumbnail\">\n\n          <p>\n\n            A simple invoice with a \n<strong>delicate layout</strong>\n,\n            \n<strong>tables</strong>\n and \n<strong>a nice footer</strong>\n.\n          \n</p>\n\n          <ul class=\"buttons\">\n            <li>\n<a href=\"https://github.com/CourtBouillon/weasyprint-samples/raw/main/invoice/invoice.pdf\">\nPDF\n</a>\n</li>\n            <li>\n<a href=\"https://github.com/CourtBouillon/weasyprint-samples/tree/main/invoice\">\nSource\n</a>\n</li>\n          </ul>\n        </article>\n\n        <article>\n          <h3>Tickets</h3>\n\n          <img loading=\"lazy\" src=\"css/img/documents/tickets-thumbnail.webp\" alt=\"Ticket thumbnail\">\n\n          <p>\n\n            A ticket with a \n<strong>barcode</strong>\n, with just\n            \n<strong>50 lines of HTML</strong>\n and \n<strong>150 lines of CSS</strong>\n.\n          \n</p>\n\n          <ul class=\"buttons\">\n            <li>\n<a href=\"https://github.com/CourtBouillon/weasyprint-samples/raw/main/ticket/ticket.pdf\">\nPDF\n</a>\n</li>\n            <li>\n<a href=\"https://github.com/CourtBouillon/weasyprint-samples/tree/main/ticket\">\nSource\n</a>\n</li>\n          </ul>\n        </article>\n\n        <article>\n          <h3>Books</h3>\n\n          <img loading=\"lazy\" src=\"css/img/documents/books-thumbnail.webp\" alt=\"Book thumbnail\">\n\n          <p>\n\n            A full book with a \n<strong>nice cover</strong>\n, a\n            \n<strong>simple table of contents</strong>\n and \n<strong>running elements</strong>\n.\n            Comes with an \n<strong>alternate stylesheet</strong>\n.\n          \n</p>\n\n          <ul class=\"buttons\">\n            <li>\n<a href=\"https://github.com/CourtBouillon/weasyprint-samples/raw/main/book/book.pdf\">\nFancy PDF\n</a>\n</li>\n            <li>\n<a href=\"https://github.com/CourtBouillon/weasyprint-samples/raw/main/book/book-classical.pdf\">\nClassical PDF\n</a>\n</li>\n            <li>\n<a href=\"https://github.com/CourtBouillon/weasyprint-samples/tree/main/book\">\nSource\n</a>\n</li>\n          </ul>\n        </article>\n\n        <article>\n          <h3>Letters</h3>\n\n          <img loading=\"lazy\" src=\"css/img/documents/letters-thumbnail.webp\" alt=\"Letter thumbnail\">\n\n          <p>\n\n            A letter with a \n<strong>nice coupon</strong>\n made of \n<strong>form inputs</strong>\n,\n            that also \n<strong>renders nicely in a browser</strong>\n.\n          \n</p>\n\n          <ul class=\"buttons\">\n            <li>\n<a href=\"https://github.com/CourtBouillon/weasyprint-samples/raw/main/letter/letter.pdf\">\nPDF\n</a>\n</li>\n            <li>\n<a href=\"https://github.com/CourtBouillon/weasyprint-samples/tree/main/letter\">\nSource\n</a>\n</li>\n          </ul>\n        </article>\n\n        <article>\n          <h3>Posters</h3>\n\n          <img loading=\"lazy\" src=\"css/img/documents/posters-thumbnail.webp\" alt=\"Poster thumbnail\">\n\n          <p>\n\n            A poster mainly composed of \n<strong>images</strong>\n fitting in \n<strong>one page</strong>\n,\n            with an \n<strong>alternate stylesheet</strong>\n used to generate \n<strong>a flyer</strong>\n.\n          \n</p>\n\n          <ul class=\"buttons\">\n            <li>\n<a href=\"https://github.com/CourtBouillon/weasyprint-samples/raw/main/poster/poster.pdf\">\nPoster PDF\n</a>\n</li>\n            <li>\n<a href=\"https://github.com/CourtBouillon/weasyprint-samples/raw/main/poster/flyer.pdf\">\nFlyer PDF\n</a>\n</li>\n            <li>\n<a href=\"https://github.com/CourtBouillon/weasyprint-samples/tree/main/poster\">\nSource\n</a>\n</li>\n          </ul>\n        </article>\n      </section>\n\n      <section id=\"support\">\n        <h2>Professional Support</h2>\n\n        <article id=\"packages\">\n          <h3>Consulting Packages</h3>\n\n          <p>\n            Get our expert assistance on your use, configuration or integration of WeasyPrint.\n          </p>\n          <article>\n            <section>\n              <h4>Basic</h4>\n              <p>1 topic per month</p>\n              <p>Reply within 1 working day</p>\n              <p>Mail only</p>\n              <p>\nYour logo and link on the \n<a href=\"#silver\">Silver section</a>\n (optional)\n</p>\n              <ul class=\"buttons\">\n                <li>\n<a href=\"mailto:contact@courtbouillon.org?subject=Basic consulting package\">\n150€ / month*\n</a>\n</li>\n              </ul>\n            </section>\n\n            <section>\n              <h4>Essential</h4>\n              <p>3 topics per month</p>\n              <p>Reply within 1 working day</p>\n              <p>Mail + 30min video call per topic</p>\n              <p>\nYour logo and link on the \n<a href=\"#gold\">Gold section</a>\n (optional)\n</p>\n              <ul class=\"buttons\">\n                <li>\n<a href=\"mailto:contact@courtbouillon.org?subject=Essential consulting package\">\n350€ / month*\n</a>\n</li>\n              </ul>\n            </section>\n\n            <section>\n              <h4>Premium</h4>\n              <p>5 topics per month</p>\n              <p>Reply within 1 working day</p>\n              <p>Mail + 30min video call per topic</p>\n              <p>\nYour logo and link on the \n<a href=\"#gold\">Gold section</a>\n (optional)\n</p>\n              <ul class=\"buttons\">\n                <li>\n<a href=\"mailto:contact@courtbouillon.org?subject=Premium consulting package\">\n550€ / month*\n</a>\n</li>\n              </ul>\n            </section>\n          </article>\n          <p>\n            * Prices exclude taxes. Annual billing. These offers are not available in Canada and USA.\n          </p>\n        </article>\n\n        <article id=\"services\">\n          <h3>Support Services</h3>\n\n          <p>\n            Enhance your experience with WeasyPrint thanks to our expertise.\n          </p>\n          <article>\n            <section>\n              <h4>Bug Fix</h4>\n              <p>A bug is making your life harder?</p>\n              <p>Get it quickly fixed.</p>\n            </section>\n\n            <section>\n              <h4>New Feature</h4>\n              <p>A feature is missing in WeasyPrint?</p>\n              <p>Let’s add it.</p>\n            </section>\n\n            <section>\n              <h4>Templating</h4>\n              <p>Need to convert a sweet design into a smart HTML/CSS template?</p>\n              <p>Get your tailor-made templates.</p>\n            </section>\n\n            <section>\n              <h4>Workflow Integration</h4>\n              <p>Want to include WeasyPrint in your workflow or application?</p>\n              <p>Let’s build that.</p>\n            </section>\n          </article>\n          <p>\n\n            Contact us by\n            \n<a title=\"contact@courtbouillon.org\" href=\"mailto:contact@courtbouillon.org\">mail</a>\n or\n            by \n<a title=\"CourtBouillon\" href=\"https://matrix.to/#/%23CourtBouillon_WeasyPrint:gitter.im\">chat</a>\n\n            to get in touch, we’ll be happy to find the best way to help you!\n          \n</p>\n          <ul class=\"buttons\">\n            <li>\n<a href=\"mailto:contact@courtbouillon.org\">\nGet in Touch\n</a>\n</li>\n          </ul>\n        </article>\n      </section>\n\n      <section id=\"sponsors\">\n        <h2>Sponsorship</h2>\n        <p>\n          With donations and sponsorship, you help the projects to be better.\n          Donations allow the CourtBouillon team to have more time dedicated to add\n          new features, fix bugs, and improve documentation.\n        </p>\n        <ul class=\"buttons\">\n          <li>\n<a href=\"https://opencollective.com/courtbouillon\">\nBecome a Sponsor\n</a>\n</li>\n        </ul>\n\n        <h3 id=\"gold\">Gold Sponsors</h3>\n        <ul class=\"sponsors gold\">\n          <li>\n<a href=\"https://www.spacinov.com\" title=\"Spacinov\">\n\n            Spacinov\n            \n<img loading=\"lazy\" alt=\"Spacinov logo\" src=\"https://www.courtbouillon.org/static/images/sponsor-spacinov.svg\">\n          </a>\n</li>\n          <li>\n<a href=\"https://www.syslifters.com/\" title=\"Syslifters\">\n\n            Syslifters\n            \n<img loading=\"lazy\" alt=\"Syslifters logo\" src=\"https://www.courtbouillon.org/static/images/sponsor-syslifters.svg\">\n          </a>\n</li>\n        </ul>\n\n        <h3 id=\"silver\">Silver Sponsors</h3>\n        <ul class=\"sponsors silver\">\n          <li>\n<a href=\"https://www.kobalt.fr/\" title=\"Kobalt\">\n\n            Kobalt\n            \n<img loading=\"lazy\" alt=\"Kobalt logo\" src=\"https://www.courtbouillon.org/static/images/sponsor-kobalt.webp\">\n          </a>\n</li>\n        </ul>\n\n        <h3>Bronze Sponsors</h3>\n        <ul class=\"sponsors bronze\">\n          <li>\n<a href=\"https://getgrip.de/\" title=\"Grip Angebotssoftware\">\n\n            Grip Angebotssoftware\n            \n<img loading=\"lazy\" alt=\"Grip Angebotssoftware logo\" src=\"https://www.courtbouillon.org/static/images/sponsor-grip.png\">\n          </a>\n</li>\n          <li>\n<a href=\"https://www.simonsoft.se/\" title=\"Simonsoft\">\n\n            Simonsoft\n            \n<img loading=\"lazy\" alt=\"SimonSoft logo\" src=\"https://www.courtbouillon.org/static/images/sponsor-simonsoft.webp\">\n          </a>\n</li>\n          <li>\n<a href=\"https://menutech.com/\" title=\"Menutech\">\n\n            Menutech\n            \n<img loading=\"lazy\" alt=\"Menutech logo\" src=\"https://www.courtbouillon.org/static/images/sponsor-menutech.svg\">\n          </a>\n</li>\n          <li>\n<a href=\"https://kontextwork.de\" title=\"KontextWork\">\n\n            KontextWork\n            \n<img loading=\"lazy\" alt=\"KontextWork logo\" src=\"https://www.courtbouillon.org/static/images/sponsor-kontextwork.webp\">\n          </a>\n</li>\n          <li>\n<a href=\"https://www.trainingsparkle.com/\" title=\"Training Sparkle\">\n\n            TrainingSparkle\n            \n<img loading=\"lazy\" alt=\"TrainingSparkle logo\" src=\"https://www.courtbouillon.org/static/images/sponsor-trainingsparkle.webp\">\n          </a>\n</li>\n          <li>\n<a href=\"https://healthchecks.io/\" title=\"Healthchecks.io\">\n\n            Healthchecks.io\n            \n<img loading=\"lazy\" alt=\"Healthchecks.io logo\" src=\"https://www.courtbouillon.org/static/images/sponsor-healthchecks.webp\">\n          </a>\n</li>\n          <li>\n<a href=\"https://hammerbacher.com/\" title=\"Hammerbacher GmbH\">\n\n            Hammerbacher GmbH\n            \n<img loading=\"lazy\" alt=\"Hammerbacher GmbH logo\" src=\"https://www.courtbouillon.org/static/images/sponsor-hammerbacher.svg\">\n          </a>\n</li>\n          <li>\n<a href=\"https://www.method-b.uk/\" title=\"Method B\">\n\n            Method B\n            \n<img loading=\"lazy\" alt=\"Method B logo\" src=\"https://www.courtbouillon.org/static/images/sponsor-method-b.svg\">\n          </a>\n</li>\n          <li>\n<a href=\"https://fieldhub.com/\" title=\"Fieldhub\">\n\n            Fieldhub\n            \n<img alt=\"Fieldhub logo\" src=\"https://www.courtbouillon.org/static/images/sponsor-fieldhub.svg\">\n          </a>\n</li>\n          <li>\n<a href=\"https://www.prothesis.fr/\" title=\"Prothesis Dental Solutions\">\n\n            Prothesis Dental Solutions\n            \n<img alt=\"Prothesis Dental Solutions logo\" src=\"https://www.courtbouillon.org/static/images/sponsor-prothesis.svg\">\n          </a>\n</li>\n          <li>\n<a href=\"https://pdfbolt.com/\" title=\"PDFBolt\">\n\n            PDFBolt\n            \n<img alt=\"Prothesis Dental Solutions logo\" src=\"https://www.courtbouillon.org/static/images/sponsor-pdfbolt.svg\">\n          </a>\n</li>\n        </ul>\n\n        <h3>Grants</h3>\n        <ul class=\"sponsors gold\">\n          <li>\n<a href=\"https://nlnet.nl/\" title=\"NLnet\">\n\n            NLnet\n            \n<img alt=\"NLnet logo\" src=\"https://www.courtbouillon.org/static/images/sponsor-nlnet.svg\">\n          </a>\n</li>\n        </ul>\n\n        <h3>Trusted By</h3>\n        <ul class=\"sponsors user\">\n          <li>\n\n            IETF\n            \n<img loading=\"lazy\" alt=\"IETF logo\" src=\"css/img/logos/ietf.svg\">\n          </li>\n          <li>\n\n            Unicode\n            \n<img loading=\"lazy\" alt=\"Unicode logo\" src=\"css/img/logos/unicode.jpg\">\n          </li>\n          <li>\n\n            Gemeente Amsterdam\n            \n<img loading=\"lazy\" alt=\"Gemeente Amsterdam logo\" src=\"css/img/logos/gemeente-amsterdam.svg\">\n          </li>\n          <li>\n\n            OpenEdition\n            \n<img loading=\"lazy\" alt=\"OpenEdition logo\" src=\"css/img/logos/openedition.svg\">\n          </li>\n          <li>\n\n            MetLife\n            \n<img loading=\"lazy\" alt=\"MetLife logo\" src=\"css/img/logos/metlife.svg\">\n          </li>\n          <li>\n\n            République Française\n            \n<img loading=\"lazy\" alt=\"République Française logo\" src=\"css/img/logos/republique-francaise.svg\">\n          </li>\n          <li>\n\n            Code&amp;Co.\n            \n<img loading=\"lazy\" alt=\"Code&amp;Co. logo\" src=\"css/img/logos/codeandco.svg\">\n          </li>\n          <li>\n\n            Universitätsbibliothek Mannheim\n            \n<img loading=\"lazy\" alt=\"Universitätsbibliothek Mannheim logo\" src=\"css/img/logos/universitatsbibliothek-mannheim.svg\">\n          </li>\n          <li>\n\n            GOV.UK\n            \n<img loading=\"lazy\" alt=\"GOV.UK logo\" src=\"css/img/logos/gov-uk.svg\">\n          </li>\n          <li>\n\n            Province of British Columbia\n            \n<img loading=\"lazy\" alt=\"Province of British Columbia logo\" src=\"css/img/logos/province-of-british-columbia.svg\">\n          </li>\n        </ul>\n      </section>\n\n      <section id=\"about\">\n        <h2>About</h2>\n\n        <p>\n\n          WeasyPrint has been created and developed by \n<a href=\"https://kozea.fr/\">Kozea</a>\n.\n          Professional support, maintenance and community management is provided by\n          \n<a href=\"https://www.courtbouillon.org/\">CourtBouillon</a>\n.\n        \n</p>\n      </section>\n    </main>\n\n    <footer>\n      <ul id=\"toc\">\n        <li>\n<a href=\"/\">WeasyPrint</a>\n</li>\n        <li>\n          <ul>\n            <li>\n<a href=\"#factory\">The Awesome Document Factory</a>\n</li>\n            <li>\n<a href=\"#figures\">Key Figures</a>\n</li>\n          </ul>\n        </li>\n        <li>\n<a href=\"#samples\">Samples</a>\n</li>\n        <li>\n<a href=\"#support\">Support</a>\n</li>\n        <li>\n<a href=\"#sponsors\">Sponsors</a>\n</li>\n      </ul>\n      <ul id=\"links\">\n        <li>\n<a id=\"website\" href=\"https://courtbouillon.org\">\nCourtBouillon\n</a>\n</li>\n        <li>\n<a id=\"mail\" href=\"mailto:contact@courtbouillon.org\">\ncontact@courtbouillon.org\n</a>\n</li>\n        <li>\n<a id=\"matrix\" href=\"https://matrix.to/#/%23CourtBouillon_WeasyPrint:gitter.im\">\nChat\n</a>\n</li>\n        <li>\n<a id=\"mastodon\" href=\"https://fosstodon.org/@courtbouillon\">\n@courtbouillon\n</a>\n</li>\n        <li>\n<a id=\"github\" href=\"https://github.com/Kozea/WeasyPrint/\">\nGitHub\n</a>\n</li>\n        <li>\n<a id=\"linkedin\" href=\"https://linkedin.com/company/courtbouillon\">\nLinkedIn\n</a>\n</li>\n      </ul>\n    </footer>\n  \n\n\n</body>",
